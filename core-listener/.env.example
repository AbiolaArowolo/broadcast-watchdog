WATCHDOG_SMTP_HOST=
WATCHDOG_SMTP_PORT=587
WATCHDOG_SMTP_USER=
WATCHDOG_SMTP_PASS=
WATCHDOG_ALERT_EMAIL_TO=
# Optional. Defaults to the bare WATCHDOG_SMTP_USER address with no display name. Set to
# "Clarixtech <same-smtp-user-address>" so event alerts (freeze, playout shut down, heartbeat
# lost, etc.) show a readable sender name instead of the raw login address. The address part
# must still match WATCHDOG_SMTP_USER -- Gmail allows a custom display name, not a different
# authenticated address.
WATCHDOG_ALERT_EMAIL_FROM=
WATCHDOG_HEARTBEAT_INTERVAL_SECONDS=10
WATCHDOG_MISSED_INTERVALS_BEFORE_ALERT=3
# Required. The listener refuses to start without it. Every sender sends it as X-Watchdog-Token.
WATCHDOG_SHARED_TOKEN=
# Optional during rotation only. This old token is accepted alongside the new one, then remove it
# after every sender has been migrated and verified.
WATCHDOG_PREVIOUS_SHARED_TOKEN=
# Per-sender keys. Normally written by an unpublished operations script (never type them by hand). A sender's own key is valid only for that sender's name.
# WATCHDOG_SENDER_AUTH: both (default; the shared key above still posts for anyone) | per-sender (only a sender's own key can post; the shared key is then
# an admin/read key only). The _PREVIOUS lines exist only while one sender is changing its key.
WATCHDOG_SENDER_AUTH=both
WATCHDOG_SENDER_KEY_MAIN=
WATCHDOG_SENDER_KEY_BACKUP_SERVER=
WATCHDOG_SENDER_KEY_SITE_A=
WATCHDOG_SENDER_KEY_SITE_B=
# Keep the interactive FastAPI documentation disabled on the public tunnel.
WATCHDOG_ENABLE_DOCS=false
# Authenticated write and public stream capacity guards.
WATCHDOG_MAX_INGEST_REQUESTS_PER_MINUTE=600
WATCHDOG_MAX_STREAMS=32
# Live streams reserved for viewers on the LAN or Tailscale; the internet cannot use them.
WATCHDOG_MAX_PRIVATE_STREAMS=16
# Per visitor (the address Cloudflare reports): live streams held at once, and /status requests per minute.
WATCHDOG_MAX_STREAMS_PER_VISITOR=8
WATCHDOG_MAX_STATUS_PER_MINUTE=60
# A viewer that stops reading is cut off after this many seconds. Cloudflare's visitor address is believed only from these networks (the tunnel's).
WATCHDOG_STREAM_SEND_TIMEOUT_SECONDS=30
WATCHDOG_TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32
# false | internet | true.  `internet` refuses plain-http posts that arrive through Cloudflare (safe now: no sender does that).
# `true` also refuses the LAN path (MAIN and BACKUP-SERVER post to http://192.168.7.183:8420): set it only after those two have an encrypted path.
WATCHDOG_REJECT_PLAIN_HTTP_POSTS=false
# Cloudflare Tunnel connector token for the public fallback path (dedicated tunnel, not a shared one).
WATCHDOG_TUNNEL_TOKEN=
# Control phase (the unpublished design notes). All empty = off. The control key is the super user's only key: at least 24 characters, different from every other key.
# Create it on the PC with `python an unpublished operations script init-key`, then put the same value here and on the standby.
WATCHDOG_CONTROL_KEY=
# Alerts go ONLY to these two while access is OFF (his own address and his own private ntfy topic).
WATCHDOG_SUPER_EMAIL_TO=
WATCHDOG_SUPER_PUSH_URL=
# The one mailbox told 'Service is OFFLINE' and 'Service is back' (support@client.example).
WATCHDOG_CONTROL_NOTICE_TO=
# The VPS's health page (https://standby.corp.example/health): lets Core watch the VPS and take over by itself when the VPS is the preferred node and goes down.
WATCHDOG_PEER_URL=
# The super user's sign-in for the control page: his e-mail address and a salted scrypt hash of his password. Both are set by `python an unpublished operations script set-password`.
# The password itself is stored nowhere. Until they are set, the control page still takes the control key.
WATCHDOG_SUPER_USER=
WATCHDOG_SUPER_PASSWORD_HASH=
