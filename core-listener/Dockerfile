# The listener's image.
#
# The base is pinned by DIGEST, not by a moving tag: `python:3.14-slim` changes under you every few weeks, and a rebuild would silently take whatever it
# points at that day. To move to a newer base on purpose: pick the new digest (`docker buildx imagetools inspect python:3.14-slim`), change it here AND in
# docker-compose.yml (the data-owner helper uses the same image), run the tests, deploy. This digest is Python 3.14.8 (read from the image, 2026-11-08).
#
# Held on Python 3.14 on purpose. On 2026-11-04 a bump to 3.15 broke the build: the lock then pinned pydantic-core 2.46.5, which has wheels for Python 3.9 to
# 3.14 only, so pip found nothing to install (the only other file is Rust source and this image has no compiler). The lock now pins pydantic-core 2.50.1,
# which does ship 3.15 wheels, but nothing has run this image on 3.15 yet, so Dependabot stays fenced off from 3.15 and newer in .github/dependabot.yml.
# To move up: change this line, the helper in docker-compose.yml, that fence, PYTHON_VERSION in ops/lock_requirements.py and the python-version lines of
# the jobs in .github/workflows/ci.yml together (tests check that they agree), re-lock, and run ops/test_container_live.py.
FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

# PYTHONDONTWRITEBYTECODE: nothing writes into the image while it runs (its filesystem is read-only); the bytecode is compiled once, below.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Every dependency comes from requirements.txt: one exact version each, with a hash for every downloadable file (generated by ops/lock_requirements.py).
# --require-hashes refuses anything that is not listed or whose bytes differ from the lock; --no-deps because the lock already names the dependencies.
COPY requirements.txt .
RUN pip install --require-hashes --no-deps -r requirements.txt

# A fixed unprivileged user that owns nothing in the image and has no shell or home. /data is the one place it can write: the compose file mounts the
# database volume there, and a brand-new volume starts out owned by this user. (An existing volume made by the old root-run container is handed over by
# the data-owner helper in docker-compose.yml.)
RUN groupadd --system --gid 10001 watchdog \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin watchdog \
 && mkdir /data \
 && chown 10001:10001 /data

COPY app ./app
# Compile once at build time. The running container's filesystem is read-only, so Python could not write its bytecode cache then.
RUN python -m compileall -q app

USER 10001:10001
# The launcher starts the same uvicorn server with the same flags and, when WATCHDOG_STAFF_DOOR_PORT is set, a second port for the staff door (app/serve.py).
CMD ["python", "-m", "app.serve", "--host", "0.0.0.0", "--port", "8420", "--no-proxy-headers"]
